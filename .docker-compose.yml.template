services:
  wg-easy:
    image: {{WGEASY_IMAGE}}
    container_name: wg-easy
    hostname: wg-easy
    environment:
      - INIT_ENABLED=true
      - INIT_USERNAME=admin
      - "INIT_PASSWORD={{WGEASY_PASSWORD}}"
      - INIT_HOST={{PUBLIC_IP}}
      - INIT_PORT=51820
      - INIT_DNS={{WGEASY_DNS}}
      - INIT_IPV4_CIDR={{WGEASY_NETWORK}}
      # The explicit Docker network route beats a client LAN that claims all of
      # 10.0.0.0/8, which would otherwise swallow traffic to *.adaka.internal
      - INIT_ALLOWED_IPS=0.0.0.0/0,::/0,{{ADAKA_NETWORK}}
      - PORT=80
      # Lets the session cookie work over http://wg.{{ADAKA_LOCAL_DOMAIN}}, which
      # WireGuard already encrypts; the public route stays HTTPS via Caddy
      - INSECURE=true
      # A smaller V8 heap makes Node collect garbage sooner on a 1 GB host
      - NODE_OPTIONS=--max-old-space-size=96
    volumes:
      - {{WGEASY_DIR}}:/etc/wireguard:rw
      - /lib/modules:/lib/modules:ro
    ports:
      - 51820:51820/udp
    restart: unless-stopped
    # Memory caps keep one container from starving the rest; overflow goes to swap
    mem_limit: 160m
    cap_add:
      - NET_ADMIN
      - SYS_MODULE
    sysctls:
      net.ipv4.ip_forward: 1
      net.ipv4.conf.all.src_valid_mark: 1
    networks:
      adaka_network:
        ipv4_address: {{WGEASY_IPV4_ADDRESS}}
    healthcheck:
      test: ["CMD", "wg", "show"]
      interval: 30s
      retries: 3

{{DNS_SECTION}}

  unbound:
    image: {{UNBOUND_IMAGE}}
    container_name: unbound
    hostname: unbound
    restart: unless-stopped
    volumes:
      - {{UNBOUND_DIR}}:/opt/unbound/etc/unbound/
    # No published ports: the DNS blocker reaches Unbound over adaka_network.
    # Publishing 5335 made it an open resolver, because Docker's port proxy
    # rewrites the source to the bridge gateway, which access-control allows.
    cap_add:
      - NET_ADMIN
    networks:
      adaka_network:
        ipv4_address: {{UNBOUND_IPV4_ADDRESS}}
    healthcheck:
      test: ["CMD", "drill", "@127.0.0.1", "-p", "5335", "cloudflare.com"]
      interval: 30s
      timeout: 10s
      retries: 3

  arcane:
    image: {{ARCANE_IMAGE}}
    container_name: arcane
    hostname: arcane
    # VPN-only via Caddy (arcane.{{ADAKA_LOCAL_DOMAIN}})
    environment:
      - ENCRYPTION_KEY={{ARCANE_ENCRYPTION_KEY}}
      - APP_URL=http://arcane.{{ADAKA_LOCAL_DOMAIN}}
      - TRUSTED_PROXIES={{CADDY_IPV4_ADDRESS}}/32
      - ANALYTICS_DISABLED=true
      - TZ={{ADAKA_DEFAULT_TZ}}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - {{ARCANE_DIR}}/data:/app/data
    # Lets Arcane identify its own container
    cgroup: host
    restart: unless-stopped
    networks:
      adaka_network:
        ipv4_address: {{ARCANE_IPV4_ADDRESS}}
    healthcheck:
      test: ["CMD", "./arcane", "health", "--timeout", "2s"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s

  fail2ban:
    image: {{FAIL2BAN_IMAGE}}
    container_name: fail2ban
    hostname: fail2ban
    restart: unless-stopped
    network_mode: host
    cap_add:
      - NET_ADMIN
      - NET_RAW
    environment:
      - PUID=1000
      - PGID=1000
      - TZ={{ADAKA_DEFAULT_TZ}}
    volumes:
      - {{FAIL2BAN_DIR}}:/config
      - /var/log:/var/log:ro

  caddy:
    image: {{CADDY_IMAGE}}
    container_name: caddy
    hostname: caddy
    restart: unless-stopped
    volumes:
      - {{CADDY_DIR}}/Caddyfile:/etc/caddy/Caddyfile:ro
      - {{CADDY_DIR}}/config:/config
      - {{CADDY_DIR}}/data:/data
    ports:
      - 51821:443/tcp
    networks:
      adaka_network:
        ipv4_address: {{CADDY_IPV4_ADDRESS}}
    depends_on:
      - wg-easy
      - searxng

  searxng:
    image: {{SEARXNG_IMAGE}}
    container_name: searxng
    hostname: searxng
    restart: unless-stopped
    mem_limit: 192m
    # VPN-only via Caddy (search.{{ADAKA_LOCAL_DOMAIN}}). settings.yml comes
    # from .searxng-settings.yml.template; the secret_key from SEARXNG_SECRET.
    environment:
      - SEARXNG_BASE_URL=http://search.{{ADAKA_LOCAL_DOMAIN}}/
      - SEARXNG_SECRET={{SEARXNG_SECRET}}
      # One user needs few concurrent requests; fewer threads hold less memory
      - GRANIAN_BLOCKING_THREADS=2
    volumes:
      - {{SEARXNG_DIR}}/config:/etc/searxng
      - {{SEARXNG_DIR}}/data:/var/cache/searxng
    # The entrypoint runs as root to chown its volumes to the searxng user and
    # then checks (or creates) settings.yml in them; without DAC_OVERRIDE root
    # can't even stat it inside the 700 config directory.
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - SETGID
      - SETUID
    networks:
      adaka_network:
        ipv4_address: {{SEARXNG_IPV4_ADDRESS}}
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://127.0.0.1:8080/healthz"]
      interval: 30s
      timeout: 5s
      retries: 3

networks:
  adaka_network:
    name: adaka_network
    ipam:
      config:
        - subnet: {{ADAKA_NETWORK}}
